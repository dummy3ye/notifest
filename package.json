{
  "name": "notifest",
  "version": "1.0.0",
  "description": "Browser notification tester and debugger built with Next.js, React, TypeScript, and Bun",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "bun scripts/buildPages.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "bun test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.0"
  }
}
